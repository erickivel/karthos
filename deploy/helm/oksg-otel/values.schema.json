{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global", "namespace", "agent", "gateway", "backend", "collectorDebug", "storage", "rollout"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["clusterName", "namespace", "releaseName", "image", "logging"],
      "properties": {
        "clusterName": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 },
        "releaseName": { "type": "string", "minLength": 1 },
        "chartPath": { "type": "string" },
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "logging": { "$ref": "#/definitions/logging" }
      }
    },
    "enabledSignals": {
      "type": "array",
      "items": { "type": "string", "enum": ["metric", "trace"] },
      "minItems": 1
    },
    "collectorDebug": {
      "type": "object",
      "required": ["enabled", "exporterID", "exporterConfig"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "exporterID": { "type": "string", "minLength": 1 },
        "exporterConfig": { "type": "object", "minProperties": 1 }
      }
    },
    "storage": {
      "type": "object",
      "required": ["backend", "postgresql", "victoriametrics"],
      "additionalProperties": false,
      "properties": {
        "backend": { "type": "string", "enum": ["memory", "external"] },
        "postgresql": {
          "type": "object",
          "required": ["enabled", "dsn"],
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" }, "dsn": { "type": "string" } }
        },
        "victoriametrics": {
          "type": "object",
          "required": ["enabled", "url"],
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" }, "url": { "type": "string" } }
        }
      },
      "allOf": [{
        "if": { "properties": { "backend": { "const": "external" } } },
        "then": { "allOf": [
          { "anyOf": [
            { "properties": { "postgresql": { "properties": { "enabled": { "const": true } } } } },
            { "properties": { "postgresql": { "properties": { "dsn": { "minLength": 1 } } } } }
          ] },
          { "anyOf": [
            { "properties": { "victoriametrics": { "properties": { "enabled": { "const": true } } } } },
            { "properties": { "victoriametrics": { "properties": { "url": { "minLength": 1 } } } } }
          ] }
        ] }
      }]
    },
    "namespace": {
      "type": "object",
      "required": ["create", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "agent": { "$ref": "#/definitions/componentDaemonSet" },
    "gateway": {
      "allOf": [
        { "$ref": "#/definitions/component" },
        {
          "type": "object",
          "required": ["replicas", "service"],
          "properties": {
            "replicas": { "type": "integer", "minimum": 1 },
            "service": {
              "type": "object",
              "required": ["type", "port", "httpPort"],
              "properties": {
                "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "httpPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
              }
            }
          }
        }
      ]
    },
    "backend": {
      "type": "object",
      "required": ["enabled", "grpcPort", "image", "service", "statusStaleSeconds", "topologyFlushInterval", "runtimeEnv", "sourceContract", "resources"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "grpcPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "image": { "$ref": "#/definitions/image" },
        "service": {
          "type": "object",
          "required": ["healthPort", "apiPort"],
          "additionalProperties": false,
          "properties": {
            "healthPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "apiPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "statusStaleSeconds": { "type": "integer", "minimum": 1 },
        "topologyFlushInterval": { "type": "string", "minLength": 1 },
        "runtimeEnv": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "sourceContract": {
          "type": "object",
          "required": ["capabilityProfile", "sourcePlan"],
          "properties": {
            "capabilityProfile": {
              "type": "object",
              "required": ["cluster_name", "capabilities"],
              "properties": {
                "cluster_name": { "type": "string", "minLength": 1 },
                "capabilities": { "type": "array", "minItems": 1 }
              }
            },
            "sourcePlan": {
              "type": "object",
              "required": ["profile_fingerprint", "selected_sources", "metric_assignments"],
              "properties": {
                "profile_fingerprint": { "type": "string", "minLength": 1 },
                "selected_sources": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "metric_assignments": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
              }
            }
          }
        },
        "resources": { "type": "object" }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecretName": { "type": "string" }
      }
    },
    "rollout": {
      "type": "object",
      "required": ["useConfigChecksum"],
      "properties": {
        "useConfigChecksum": { "type": "boolean" }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "logging": {
      "type": "object",
      "required": ["format", "level"],
      "properties": {
        "format": { "type": "string", "enum": ["json"] },
        "level": { "type": "string", "enum": ["debug", "info", "warn", "error"] }
      }
    },
    "component": {
      "type": "object",
      "required": ["enabled", "logging", "collectorConfig"],
      "properties": {
        "enabled": { "type": "boolean" },
        "logging": { "$ref": "#/definitions/logging" },
        "featureGates": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "runtimeEnv": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "collectorConfig": { "type": "string", "minLength": 1 },
        "resources": { "type": "object" }
      }
    },
    "componentDaemonSet": {
      "allOf": [
        { "$ref": "#/definitions/component" },
        {
          "type": "object",
          "required": ["hostNetwork"],
          "properties": {
            "hostNetwork": { "type": "boolean" },
            "tolerations": {
              "type": "array",
              "items": { "type": "object" }
            },
            "nodeSelector": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      ]
    }
  }
}
