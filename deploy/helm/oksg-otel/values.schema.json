{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global", "agent", "gateway", "backend", "storage"],
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "required": ["clusterName", "image"],
      "additionalProperties": false,
      "properties": {
        "clusterName": { "type": "string", "minLength": 1 },
        "image": { "$ref": "#/definitions/image" }
      }
    },
    "enabledSignals": {
      "type": "array",
      "items": { "type": "string", "enum": ["metric", "trace"] },
      "minItems": 1
    },
    "storage": {
      "type": "object",
      "required": ["backend", "postgresql", "victoriametrics"],
      "additionalProperties": false,
      "properties": {
        "backend": { "type": "string", "enum": ["memory", "external"] },
        "postgresql": {
          "type": "object",
          "required": ["enabled", "dsn"],
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" }, "dsn": { "type": "string" } }
        },
        "victoriametrics": {
          "type": "object",
          "required": ["enabled", "url"],
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" }, "url": { "type": "string" } }
        }
      },
      "allOf": [{
        "if": { "properties": { "backend": { "const": "external" } } },
        "then": { "allOf": [
          { "anyOf": [
            { "properties": { "postgresql": { "properties": { "enabled": { "const": true } } } } },
            { "properties": { "postgresql": { "properties": { "dsn": { "minLength": 1 } } } } }
          ] },
          { "anyOf": [
            { "properties": { "victoriametrics": { "properties": { "enabled": { "const": true } } } } },
            { "properties": { "victoriametrics": { "properties": { "url": { "minLength": 1 } } } } }
          ] }
        ] }
      }]
    },
    "agent": {
      "type": "object",
      "required": ["collectorConfig", "resources", "tolerations", "nodeSelector"],
      "additionalProperties": false,
      "properties": {
        "collectorConfig": { "type": "string", "minLength": 1 },
        "resources": { "type": "object" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "gateway": {
      "type": "object",
      "required": ["collectorConfig", "resources", "replicas", "service"],
      "additionalProperties": false,
      "properties": {
        "collectorConfig": { "type": "string", "minLength": 1 },
        "resources": { "type": "object" },
        "replicas": { "type": "integer", "minimum": 1 },
        "service": {
          "type": "object",
          "required": ["type", "port", "httpPort"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "httpPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "required": ["grpcPort", "logLevel", "image", "service", "statusStaleSeconds", "topologyFlushInterval", "sourceContract", "resources"],
      "additionalProperties": false,
      "properties": {
        "grpcPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "logLevel": { "type": "string", "enum": ["info", "warn", "error"] },
        "image": { "$ref": "#/definitions/image" },
        "service": {
          "type": "object",
          "required": ["healthPort", "apiPort"],
          "additionalProperties": false,
          "properties": {
            "healthPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "apiPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "statusStaleSeconds": { "type": "integer", "minimum": 1 },
        "topologyFlushInterval": { "type": "string", "minLength": 1 },
        "sourceContract": {
          "type": "object",
          "required": ["capabilityProfile", "sourcePlan"],
          "additionalProperties": false,
          "properties": {
            "capabilityProfile": {
              "type": "object",
              "required": ["cluster_name", "capabilities"],
              "additionalProperties": false,
              "properties": {
                "cluster_id": { "type": "string" },
                "cluster_name": { "type": "string", "minLength": 1 },
                "discovered_at": { "type": "string" },
                "capabilities": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["source_id", "kind", "status", "signals"],
                    "additionalProperties": false,
                    "properties": {
                      "source_id": { "type": "string", "minLength": 1 },
                      "kind": { "type": "string", "enum": ["direct", "derived"] },
                      "status": { "type": "string", "enum": ["available", "partial", "unavailable"] },
                      "signals": { "type": ["array", "null"], "items": { "type": "string", "minLength": 1 } },
                      "evidence": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "prometheus_targets": { "type": "array", "items": { "type": "object", "required": ["service_name", "namespace", "port", "path"], "additionalProperties": false, "properties": { "service_name": { "type": "string" }, "namespace": { "type": "string" }, "port": { "type": "integer" }, "path": { "type": "string" } } } },
                          "otlp": { "type": "object", "required": ["traces_enabled"], "additionalProperties": false, "properties": { "traces_enabled": { "type": "boolean" } } },
                          "mesh": { "type": "object", "required": ["flavor", "mode", "injected_namespaces", "metrics_port", "metrics_path"], "additionalProperties": false, "properties": { "flavor": { "type": "string" }, "mode": { "type": "string" }, "injected_namespaces": { "type": "array", "items": { "type": "string" } }, "metrics_port": { "type": "integer" }, "metrics_path": { "type": "string" } } }
                        }
                      }
                    }
                  }
                }
              }
            },
            "sourcePlan": {
              "type": "object",
              "required": ["profile_fingerprint", "selected_sources", "metric_assignments"],
              "additionalProperties": false,
              "properties": {
                "profile_fingerprint": { "type": "string", "minLength": 1 },
                "selected_sources": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "metric_assignments": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
              }
            }
          }
        },
        "resources": { "type": "object" }
      }
    },
    "frontend": {
      "type": "object",
      "required": ["enabled", "image", "replicas", "service", "resources"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "replicas": { "type": "integer", "minimum": 1 },
        "service": {
          "type": "object",
          "required": ["type", "port"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "resources": { "type": "object" }
      }
    },
    "postgresql": {
      "type": "object"
    },
    "victoria-metrics-single": {
      "type": "object"
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    }
  }
}
