# Default cluster profile: kind + local.
# Selected when CLUSTER_PROFILE is unset or set to "oksg-test".
CLUSTER_ENGINE=kind
KIND_CLUSTER_NAME=oksg-test
KIND_REGISTRY_NAME=oksg-kind-registry
KIND_REGISTRY_PORT=5001
REGISTRY_HOST=localhost:5001
IMAGE_TAG=latest
# KUBECONFIG left unset -> resolver falls back to $HOME/.kube/config
