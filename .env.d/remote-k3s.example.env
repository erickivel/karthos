# Example cluster profile: k3s on a remote Ubuntu host reached over SSH.
#
# Copy this file to .env.d/<your-profile>.env (e.g. .env.d/remote-k3s.env),
# fill in the placeholders below, then activate with:
#   echo CLUSTER_PROFILE=<your-profile> > .env
#
# Prerequisites (see docs/remote-cluster.md):
#   - k3s already installed on the server and reachable via `ssh <K3S_SSH_HOST>`
#   - k3s started with `--tls-san=<K3S_SERVER_IP>` so the cert validates
#     against the IP embedded in the exported kubeconfig
#   - SSH key-based auth to the server (no interactive password)
#   - Docker installed on the server (used to run the in-cluster registry)

CLUSTER_ENGINE=k3s
CLUSTER_LOCATION=ssh

# SSH alias or `user@host` used to reach the server (must work with `ssh <value>`).
K3S_SSH_HOST=<your-ssh-alias>

# IP or hostname embedded into the exported kubeconfig and validated against
# the k3s TLS cert. Usually the server's LAN IP.
K3S_SERVER_IP=<your-server-ip>

K3S_API_PORT=6443
IMAGE_TAG=latest

# Remote k3s test hosts are commonly linux/amd64 while Apple Silicon Docker
# builds linux/arm64 by default. Leave empty only when the cluster node arch
# matches the local Docker daemon arch.
IMAGE_PLATFORM=linux/amd64

# Where the rewritten kubeconfig will be written. Pick a path per server so
# multiple remote profiles don't collide.
KUBECONFIG=$HOME/.kube/configs/<your-profile>.yaml
