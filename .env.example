# Copy this file to .env to select an E2E cluster cell.
# CLUSTER_PROFILE points at a file under .env.d/ that carries the engine,
# registry, kubeconfig, and kind/k3s settings. See docs/remote-cluster.md.
#
# Supported profiles:
#   karthos-test      kind + local (default)
#   <your-name>    k3s + ssh (copy .env.d/remote-k3s.example.env first)

# CLUSTER_PROFILE=karthos-test
