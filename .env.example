# =============================================================================
# OKSG Environment Variables
# =============================================================================
# Copy this file to .env and adjust values as needed.
# Variables with defaults shown are optional.

# -----------------------------------------------------------------------------
# Cluster Targeting
# -----------------------------------------------------------------------------
# CLUSTER_PROFILE points at a file under .env.d/ that carries everything else
# (engine, registry, kubeconfig, kind/k3s knobs). Switch clusters by changing
# this single variable. See docs/remote-cluster.md for the supported cells.
#
# Supported profiles:
#   oksg-test      kind + local        (default; current behaviour)
#   <your-name>    k3s + ssh           (copy .env.d/remote-k3s.example.env to
#                                       .env.d/<your-name>.env, fill it in, then
#                                       set CLUSTER_PROFILE=<your-name> below)

# CLUSTER_PROFILE=oksg-test

# -----------------------------------------------------------------------------
# Kubernetes Configuration
# -----------------------------------------------------------------------------

# Namespace for OTel collector resources
# OKSG_NAMESPACE=oksg-system

# -----------------------------------------------------------------------------
# Test Microservices Configuration (used in e2e apps)
# -----------------------------------------------------------------------------

# URL for service-a (Python Flask service)
# SERVICE_A_URL=http://service-a-python.oksg-demo.svc.cluster.local:8081/process

# URL for service-b (Node.js Express service)
# SERVICE_B_URL=http://service-b-node.oksg-demo.svc.cluster.local:8082/compute

# -----------------------------------------------------------------------------
# OTel Collector Configuration (set automatically in K8s pods)
# -----------------------------------------------------------------------------

# Node name for kubeletstats receiver (set via downward API in K8s)
# K8S_NODE_NAME=<set-by-kubernetes>

# -----------------------------------------------------------------------------
# Backend API Configuration
# -----------------------------------------------------------------------------

# Listen address for the REST API server
# OKSG_BACKEND_API_LISTEN_ADDRESS=:8080

# Seconds before a graph snapshot is considered stale for status reporting
# OKSG_BACKEND_STATUS_STALE_SECONDS=300

# -----------------------------------------------------------------------------
# Development Tools
# -----------------------------------------------------------------------------

# Go version used in CI
# GO_VERSION=1.26.3

# Task runner version used in CI
# TASK_VERSION=3.40.1
